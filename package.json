{
  "name": "brieftube",
  "description": "YouTube videos, summarized as audio, delivered to your Telegram - Full SaaS Platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build --turbo",
    "type:generate": "next typegen .",
    "clean": "next lint --fix && tsc --noEmit && prettier --write .",
    "dev": "next dev --turbopack",
    "email": "email dev",
    "format": "prettier --write .",
    "postinstall": "pnpm type:generate",
    "knip": "knip-bun --config knip.json",
    "lint": "eslint . --fix",
    "start": "next start",
    "stripe-webhooks": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "ts": "tsc --noEmit",
    "type:supabase": "supabase gen types typescript --local > src/types/supabase.ts",
    "vercel-build": "pnpm build",
    "test": "vitest",
    "test:e2e": "HEADLESS=0 playwright test --ui",
    "test:ci": "vitest run --passWithNoTests",
    "test:e2e:ci": "HEADLESS=TRUE playwright test --pass-with-no-tests",
    "lint:ci": "eslint .",
    "prepare": "husky"
  },
  "dependencies": {
