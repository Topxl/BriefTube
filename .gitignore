# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files — deny everything, then allow the templates back.
# Blanket rule on purpose: this repo is public, and a single .env.production
# slipping through would leak every key at once.
.env
.env.*
*.env
!.env.example
!*.env.example


# typescript
*.tsbuildinfo

.env

/test-results
.vercel

src/generated

# CI artifacts
/ci-artifacts

.playwright-mcp

# Python
__pycache__/
*.py[cod]
.pytest_cache/
worker/venv/
worker/*.log
worker/*.log.*
worker/kokoro_models/

# Worker temporary files
worker/audio/*.mp3
worker/*.pid
worker/*.lock
worker/cookies/
worker/.env
worker/*.json
!worker/.env.example
worker/test_outputs/

# Root-level log files
*.log

# Infisical config (project-local only)
.infisical.json

# Sentry
.env.sentry-build-plugin

# Local settings and AI agent configurations
.claude/
_bmad/

# IDE configuration (local)
.cursor/

# Package lock (using pnpm)
package-lock.json

# Documentation and config files (not needed in public repo)
AGENTS.md
CLAUDE.md
conductor.json
start-tunnel.sh
# content/ - Now tracked for posts, docs, and changelog
docs/
# Internal working documents — not part of the public project
.env-template
SIMPLIFICATION-PLAN.md
INTEGRATION-SUPABASE.md
_bmad-output/
scripts/conductor-*.sh
MARKETING-AUDIT.md
.audit-marketing/
