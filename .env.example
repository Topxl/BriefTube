################################################################################
#  BriefTube — environment configuration
#
#  Getting started:
#      cp .env.example .env
#      # fill in the MINIMAL SETUP block below
#      docker compose up -d
#
#  MINIMAL SETUP — only three providers are needed to run BriefTube:
#      1. Supabase  → NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                     SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#      2. Gemini    → GEMINI_API_KEY
#      3. Telegram  → TELEGRAM_BOT_TOKEN
#  Everything else in this file is OPTIONAL: leave it blank and the matching
#  feature simply stays off.
#
#  File format rules (docker compose reads this file verbatim):
#      - no surrounding quotes around values
#      - no inline comments after a value; comments live on their own line
#
#  Build-time vs runtime:
#      NEXT_PUBLIC_* values are inlined into the browser bundle when the web
#      image is built. After changing one, rebuild:
#          docker compose up -d --build web
################################################################################


################################################################################
#  CORE
################################################################################

# REQUIRED — public URL where the web app is reachable.
# Used for OAuth redirects, emails and canonical links.
# Example for a local install: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL — URL the Python worker uses to call the web app back
# (push notifications, video processing callbacks).
# Inside docker compose the default http://web:3000 already works.
# Set it to your public URL if the worker runs outside the compose network.
APP_URL=http://web:3000

# OPTIONAL — host ports published by docker compose. Change them if 3000 or
# 8080 is already taken on the machine.
WEB_PORT=3000
WORKER_HEALTH_PORT=8080

# REQUIRED for self-hosting — keep this at true.
# src/lib/env.ts marks the Stripe and Google OAuth keys as mandatory because the
# hosted SaaS needs them. A self-hosted instance does not, so schema validation
# is skipped. Set to false only if you filled in every "required" key.
SKIP_ENV_VALIDATION=true

# OPTIONAL — user id (profiles.id) granted access to /dashboard/admin.
# Get it from the Supabase dashboard → Table editor → profiles → your row.
ADMIN_USER_ID=

# OPTIONAL — shared secret protecting the worker's /health and /logs endpoints.
# Any random string. Must be identical for the web and worker services.
# Generate one with: openssl rand -hex 32
WORKER_API_SECRET=

# OPTIONAL — base URL of the worker HTTP API, read by the admin panel to display
# worker logs and service health. Inside docker compose: http://worker:8080
VPS_WORKER_URL=

# OPTIONAL — Bearer token required by the /api/cron/* routes.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# OPTIONAL — 32-byte hex key (64 characters) encrypting the stored YouTube OAuth
# refresh tokens (AES-256-GCM). Required only for the "import my YouTube
# subscriptions" feature. Generate with: openssl rand -hex 32
YOUTUBE_TOKEN_KEY=

# OPTIONAL — separate key for the browser-extension auth handoff.
# Falls back to YOUTUBE_TOKEN_KEY when empty. Generate with: openssl rand -hex 32
EXTENSION_HANDOFF_KEY=

# OPTIONAL — shared secret validating YouTube WebSub (PubSubHubbub) callbacks.
# Without it, new videos are still picked up by the RSS scan, just less quickly.
# Generate with: openssl rand -hex 32
WEBSUB_SECRET=


################################################################################
#  SUPABASE  (database + auth + storage)
#
#  Supabase stays an external dependency — nothing to self-host here.
#  1. Create a free project: https://supabase.com/dashboard
#  2. Keys live in Project Settings → API
#  3. Apply the SQL files in migrations/ via the SQL editor
################################################################################

# REQUIRED — Project Settings → API → Project URL
# Inlined at build time; rebuild the web image after changing it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# REQUIRED — Project Settings → API → Project API keys → anon / public
# Safe to expose: it is protected by Row Level Security.
# Inlined at build time; rebuild the web image after changing it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# REQUIRED — same URL as above, read by the Python worker.
SUPABASE_URL=https://your-project.supabase.co

# REQUIRED — Project Settings → API → Project API keys → service_role
# SECRET: bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OPTIONAL — direct PostgreSQL connection string used by the worker to bypass
# the PostgREST request quota on the Supabase free tier.
# Project Settings → Database → Connection string → Transaction pooler
# Example: postgresql://postgres.abcdef:PASSWORD@aws-1-us-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=


################################################################################
#  AUTHENTICATION  (Google OAuth)
#
#  Sign-in itself is handled by Supabase Auth: enable the Google provider in
#  Authentication → Providers and paste the same client id/secret there.
#  The keys below are additionally required for the "import my YouTube
#  subscriptions" flow, which calls the YouTube Data API on the user's behalf.
#  Console: https://console.cloud.google.com/apis/credentials
################################################################################

# OPTIONAL — OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OPTIONAL — OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your-client-secret


################################################################################
#  AI  (summaries + transcription)
################################################################################

# REQUIRED — Google Gemini, generates the video summaries.
# Free tier is enough for personal use: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# OPTIONAL — OpenRouter, used as a summariser fallback when Gemini is rate
# limited or unavailable: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPTIONAL — Groq, runs Whisper transcription when a video has no YouTube
# subtitles. Generous free tier: https://console.groq.com/keys
GROQ_API_KEY=

# OPTIONAL — OpenAI, last-resort Whisper transcription (paid).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL — YouTube Data API v3 key, used for richer channel metadata.
# The app falls back to RSS and oEmbed without it.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=


################################################################################
#  DELIVERY  (where the summaries are sent)
################################################################################

# --- Telegram ---------------------------------------------------------------
# REQUIRED — the bot that delivers summaries to your users.
# Create one by messaging https://t.me/BotFather → /newbot → copy the token.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# OPTIONAL — your personal Telegram chat id, receives admin alerts.
# Get it by messaging https://t.me/userinfobot
ADMIN_TELEGRAM_CHAT_ID=

# OPTIONAL — a second, separate bot that streams the worker logs to Telegram.
# Create it the same way via @BotFather.
LOG_BOT_TOKEN=
LOG_BOT_ADMIN_CHAT_ID=

# --- Slack ------------------------------------------------------------------
# OPTIONAL — https://api.slack.com/apps → your app → Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must match the redirect URL registered on the Slack app.
# Example: http://localhost:3000/api/connect/slack/callback
SLACK_REDIRECT_URI=

# --- Discord ----------------------------------------------------------------
# OPTIONAL — https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Example: http://localhost:3000/api/connect/discord/callback
DISCORD_REDIRECT_URI=

# --- Notion -----------------------------------------------------------------
# OPTIONAL — https://www.notion.so/my-integrations (public integration)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Example: http://localhost:3000/api/connect/notion/callback
NOTION_REDIRECT_URI=

# --- WhatsApp (via Twilio) --------------------------------------------------
# OPTIONAL — https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number in Twilio's WhatsApp format.
# Example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# --- Web push (browser notifications) ---------------------------------------
# OPTIONAL — VAPID key pair. Generate one with:
#   npx web-push generate-vapid-keys
# The public key is inlined at build time; rebuild the web image after changing it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto: address advertised to the push service.
# Example: mailto:you@example.com
VAPID_SUBJECT=
# Shared secret between the worker and the /api/push/send endpoint.
# Generate with: openssl rand -hex 32
PUSH_NOTIFY_SECRET=


################################################################################
#  STORAGE  (generated MP3 files)
#
#  Entirely optional. Without R2 the worker keeps the audio on the local volume
#  (./worker/audio) and Telegram delivery still works. Configure R2 when you
#  want the audio served from a CDN with zero egress cost.
#  Console: https://dash.cloudflare.com → R2
################################################################################

# OPTIONAL — Cloudflare Account ID, shown in the R2 dashboard sidebar.
R2_ACCOUNT_ID=

# OPTIONAL — R2 API token → Access Key ID
R2_ACCESS_KEY_ID=

# OPTIONAL — R2 API token → Secret Access Key
R2_SECRET_ACCESS_KEY=

# OPTIONAL — bucket name (default: brieftube-audio)
R2_BUCKET_NAME=brieftube-audio

# OPTIONAL — public base URL of the bucket, no trailing slash.
# Example: https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=

# OPTIONAL — route R2 traffic through an HTTP proxy. Only needed when the local
# network blocks Cloudflare IP ranges.
# Example: http://user:pass@host:port
R2_PROXY_HTTP=


################################################################################
#  PAYMENTS  (Stripe)
#
#  ALL OPTIONAL — a self-hosted instance has no billing. Leave every key blank
#  and keep SKIP_ENV_VALIDATION=true; the pricing pages simply stay inert.
#  Console: https://dashboard.stripe.com/apikeys
################################################################################

# OPTIONAL — Developers → API keys → Secret key
STRIPE_SECRET_KEY=

# OPTIONAL — Developers → API keys → Publishable key
# Inlined at build time; rebuild the web image after changing it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OPTIONAL — Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# OPTIONAL — price ids of the paid plans (Product catalogue → your product).
# Example: price_1AbCdEfGhIjKlMnO
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_PLUS_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=


################################################################################
#  EMAIL  (Resend)
#
#  ALL OPTIONAL — transactional emails (welcome, support replies, digests).
#  Console: https://resend.com/api-keys
################################################################################

# OPTIONAL — API key
RESEND_API_KEY=

# OPTIONAL — audience id for the newsletter list (Resend → Audiences)
RESEND_AUDIENCE_ID=

# OPTIONAL — signing secret of the Resend webhook (Resend → Webhooks)
RESEND_WEBHOOK_SECRET=

# OPTIONAL — verified sender. The domain must be verified in Resend.
# Example: BriefTube <noreply@example.com>
EMAIL_FROM=

# OPTIONAL — support address displayed in the UI.
# Inlined at build time; rebuild the web image after changing it.
NEXT_PUBLIC_EMAIL_CONTACT=


################################################################################
#  MONITORING & ANALYTICS
#
#  ALL OPTIONAL — nothing here is needed to run BriefTube.
################################################################################

# OPTIONAL — Sentry error reporting. https://sentry.io → Project settings → Client keys
# Leave both blank and Sentry never initializes: no data leaves your instance.
# The client DSN is inlined at build time; rebuild the web image after changing it.
NEXT_PUBLIC_SENTRY_DSN=
# OPTIONAL — server-side DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when unset.
SENTRY_DSN=

# OPTIONAL — PostHog product analytics. https://app.posthog.com → Project settings
# Both are inlined at build time; rebuild the web image after changing them.
NEXT_PUBLIC_POSTHOG_KEY=
# Example: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# OPTIONAL — PostHog personal API key + project id, read by the admin panel to
# display visitor statistics. https://app.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# OPTIONAL — Google Ads conversion label, appended to the gtag send_to value.
# Google Ads → Goals → Conversions → your action → Tag setup.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# OPTIONAL — Upstash Redis, backs the API rate limiters. Without it, rate
# limiting is silently disabled. https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL — set to true to turn rate limiting off even when Redis is configured.
DISABLE_RATE_LIMIT=

# OPTIONAL — Inngest, orchestrates the daily newsletter digest.
# https://app.inngest.com → Manage → Event keys / Signing key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


################################################################################
#  WORKER TUNING
#
#  ALL OPTIONAL — every value below has a sane default in worker/config.py.
#  Uncomment only what you want to change.
################################################################################

# Default TTS voice. Users can override it in their profile.
# Examples: en-US-JennyNeural, fr-FR-DeniseNeural, es-ES-ElviraNeural
TTS_VOICE=en-US-JennyNeural

# Seconds between two RSS scans (default 7200 = 2 h).
RSS_CHECK_INTERVAL=7200

# How many videos the worker processes at once (default 4).
# Raise it only if your database plan and CPU can take the load.
MAX_CONCURRENT_VIDEOS=4

# full = RSS scanner + processor + deliverer (default)
# processor = processing only, for extra worker instances
WORKER_MODE=full

# Offset applied to the health port when running several instances
# (instance 0 → 8080, instance 1 → 8081, ...).
WORKER_INSTANCE=0

# Port of the worker HTTP server inside the container.
HEALTH_PORT=8080

# Resource guards: the worker pauses before starting a new job when the machine
# is under pressure. Set MAX_CPU_PERCENT=100 to disable the CPU/load checks.
MAX_CPU_PERCENT=80
MAX_LOAD_PER_CPU=0.9
MIN_FREE_RAM_MB=512
CPU_CHECK_INTERVAL=5.0

# Plan limits — keep in sync with SiteConfig in src/site-config.ts.
FREE_CHANNELS_LIMIT=5
TRIAL_DAYS=30

# OPTIONAL — HTTP proxy for YouTube requests. Datacenter IPs are frequently
# blocked by YouTube; a residential proxy fixes transcript extraction.
# Example: http://user:pass@host:port
YOUTUBE_PROXY_HTTP=
