# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@your-project.supabase.com:6543/postgres

# ── Google OAuth (login + YouTube import) ─────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=BriefTube <noreply@brieftube.app>
NEXT_PUBLIC_EMAIL_CONTACT=contact@brieftube.app

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Ads ─────────────────────────────────────────────
# Conversion label for the "Abonnement (1)" action (id 7512654413).
# Where to find it: Google Ads → Goals → Conversions → "Abonnement (1)"
#   → Tag setup → Install tag yourself → copy the string AFTER "AW-17972477350/"
#   in the `send_to` line. Current value as of 2026-04-08: tfEHCM2EqP4bEKb7-PlC
# IMPORTANT: NEXT_PUBLIC_* vars are inlined at build time — after changing this
# in Vercel env vars you MUST redeploy for the new value to take effect.
# If this is empty in production, trackAdConversion() logs an error and nothing
# is reported to Google Ads (cause of the 2026-04 "0 conversions" incident).
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=tfEHCM2EqP4bEKb7-PlC
