{
  "mailer_subjects_confirmation": "Welcome to BriefTube — confirm your email",
  "mailer_templates_confirmation_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Welcome to BriefTube</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">Confirm your email to start summarizing your YouTube channels. The link expires in 60 minutes.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#ef4444\" style=\"border-radius:8px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;color:#ffffff;font-weight:600;font-size:15px;text-decoration:none;font-family:Arial,Helvetica,sans-serif;\">Confirm email</a></td></tr></table><p style=\"color:#71717a;font-size:13px;line-height:1.5;margin:28px 0 0;\">If the button doesn&#39;t work, paste this URL into your browser:</p><p style=\"color:#a1a1aa;font-size:13px;line-height:1.5;word-break:break-all;margin:6px 0 0;\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">If you didn&#39;t request this, you can safely ignore this email.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_magic_link": "Sign in to BriefTube",
  "mailer_templates_magic_link_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Sign in to BriefTube</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">Click the button below to sign in. The link expires in 60 minutes and can only be used once.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#ef4444\" style=\"border-radius:8px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;color:#ffffff;font-weight:600;font-size:15px;text-decoration:none;font-family:Arial,Helvetica,sans-serif;\">Sign in</a></td></tr></table><p style=\"color:#71717a;font-size:13px;line-height:1.5;margin:28px 0 0;\">If the button doesn&#39;t work, paste this URL into your browser:</p><p style=\"color:#a1a1aa;font-size:13px;line-height:1.5;word-break:break-all;margin:6px 0 0;\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">If you didn&#39;t request this, you can safely ignore this email.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_invite": "You've been invited to BriefTube",
  "mailer_templates_invite_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">You've been invited</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">Someone invited you to BriefTube. Accept the invitation to start receiving AI audio summaries of the YouTube channels that matter to you.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#ef4444\" style=\"border-radius:8px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;color:#ffffff;font-weight:600;font-size:15px;text-decoration:none;font-family:Arial,Helvetica,sans-serif;\">Accept invite</a></td></tr></table><p style=\"color:#71717a;font-size:13px;line-height:1.5;margin:28px 0 0;\">If the button doesn&#39;t work, paste this URL into your browser:</p><p style=\"color:#a1a1aa;font-size:13px;line-height:1.5;word-break:break-all;margin:6px 0 0;\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">If you didn&#39;t request this, you can safely ignore this email.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_recovery": "Reset your BriefTube password",
  "mailer_templates_recovery_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Reset your password</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">Click the button below to set a new password. The link expires in 60 minutes.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#ef4444\" style=\"border-radius:8px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;color:#ffffff;font-weight:600;font-size:15px;text-decoration:none;font-family:Arial,Helvetica,sans-serif;\">Reset password</a></td></tr></table><p style=\"color:#71717a;font-size:13px;line-height:1.5;margin:28px 0 0;\">If the button doesn&#39;t work, paste this URL into your browser:</p><p style=\"color:#a1a1aa;font-size:13px;line-height:1.5;word-break:break-all;margin:6px 0 0;\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">If you didn&#39;t request this, you can safely ignore this email.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_email_change": "Confirm your new email",
  "mailer_templates_email_change_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Confirm your new email</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">You requested to change the email on your BriefTube account. Click the button to confirm the new address. The link expires in 60 minutes.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#ef4444\" style=\"border-radius:8px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;color:#ffffff;font-weight:600;font-size:15px;text-decoration:none;font-family:Arial,Helvetica,sans-serif;\">Confirm new email</a></td></tr></table><p style=\"color:#71717a;font-size:13px;line-height:1.5;margin:28px 0 0;\">If the button doesn&#39;t work, paste this URL into your browser:</p><p style=\"color:#a1a1aa;font-size:13px;line-height:1.5;word-break:break-all;margin:6px 0 0;\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">If you didn&#39;t request this, you can safely ignore this email.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_reauthentication": "Verify it's you — BriefTube",
  "mailer_templates_reauthentication_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Verify it's you</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">We need to verify your identity before completing this sensitive action. Enter the code below in BriefTube to continue. The code expires in 60 minutes.<br><br><span style=\"display:inline-block;background:#1f1f1f;color:#ffffff;font-family:Menlo,Consolas,monospace;font-size:24px;font-weight:700;letter-spacing:6px;padding:12px 20px;border-radius:8px;\">{{ .Token }}</span></p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">If you didn&#39;t initiate this action, change your password immediately.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_email_changed_notification": "Your BriefTube email was changed",
  "mailer_templates_email_changed_notification_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Email address updated</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">The email address on your BriefTube account has been changed to <strong style=\"color:#ffffff;\">{{ .NewEmail }}</strong>. If you didn&#39;t make this change, contact support immediately.</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">Need help? Reach us at brief-tube.com/support.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_password_changed_notification": "Your BriefTube password was changed",
  "mailer_templates_password_changed_notification_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Password updated</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">The password on your BriefTube account was just changed. If you didn&#39;t make this change, secure your account immediately by resetting your password.</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">Need help? Reach us at brief-tube.com/support.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_phone_changed_notification": "Your BriefTube phone number was changed",
  "mailer_templates_phone_changed_notification_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Phone number updated</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">The phone number on your BriefTube account was just changed. If you didn&#39;t make this change, secure your account immediately.</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">Need help? Reach us at brief-tube.com/support.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_identity_linked_notification": "A new sign-in method was linked to your BriefTube account",
  "mailer_templates_identity_linked_notification_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Sign-in method linked</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">A new sign-in method was just linked to your BriefTube account. If you didn&#39;t do this, secure your account immediately.</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">Need help? Reach us at brief-tube.com/support.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_identity_unlinked_notification": "A sign-in method was removed from your BriefTube account",
  "mailer_templates_identity_unlinked_notification_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Sign-in method removed</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">A sign-in method was just removed from your BriefTube account. If you didn&#39;t do this, secure your account immediately.</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">Need help? Reach us at brief-tube.com/support.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_mfa_factor_enrolled_notification": "Two-factor authentication enabled — BriefTube",
  "mailer_templates_mfa_factor_enrolled_notification_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Two-factor authentication enabled</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">Two-factor authentication was just enabled on your BriefTube account. Your account is now better protected.</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">If you didn&#39;t do this, contact support immediately.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>",
  "mailer_subjects_mfa_factor_unenrolled_notification": "Two-factor authentication disabled — BriefTube",
  "mailer_templates_mfa_factor_unenrolled_notification_content": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"background-color:#0a0a0a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0a0a0a\"><tr><td align=\"center\" style=\"padding:40px 20px;\"><table role=\"presentation\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#111111\" style=\"max-width:520px;border-radius:12px;\"><tr><td style=\"padding:32px;\"><div style=\"margin-bottom:24px;font-weight:700;font-size:22px;letter-spacing:-0.3px;line-height:1;white-space:nowrap;\"><span style=\"color:#ffffff;\">Brief</span><span style=\"color:#ef4444;\">Tube</span></div><h1 style=\"color:#ffffff;font-size:22px;font-weight:700;margin:0 0 12px;\">Two-factor authentication disabled</h1><p style=\"color:#a1a1aa;font-size:15px;line-height:1.5;margin:0 0 24px;\">Two-factor authentication was just disabled on your BriefTube account. If you didn&#39;t do this, secure your account immediately.</p><hr style=\"border:none;border-top:1px solid #1f1f1f;margin:28px 0;\"><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:0;\">Need help? Reach us at brief-tube.com/support.</p></td></tr></table><p style=\"color:#52525b;font-size:12px;line-height:1.5;margin:20px 0 0;\">BriefTube &middot; brief-tube.com</p></td></tr></table></body></html>"
}
