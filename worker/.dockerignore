# Build context for the `worker` service (this directory).
# Without these exclusions `COPY . .` would drag in the local virtualenv and
# multi-megabyte log files.

# --- python environment ---
venv
.venv
__pycache__
*.py[cod]
.pytest_cache

# --- secrets & local env ---
.env
.env.*
!.env.example
.infisical.json
cookies

# --- runtime state (mounted as volumes by docker-compose.yml) ---
audio
cache
transcripts
kokoro_models
*.pid
*.lock

# --- logs ---
*.log
*.log.*

# --- tests & scratch output ---
tests
test_outputs
test_pipeline_output

# --- docs & host-only tooling ---
*.md
Dockerfile
docker-compose.yml
.dockerignore
brieftube-worker.service
start.sh
stop.sh
restart.sh
