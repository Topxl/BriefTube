[Unit]
Description=BriefTube SaaS Worker (Telegram Bot + Video Processor)
After=network.target

[Service]
Type=simple
User=brieftube
WorkingDirectory=/home/brieftube/app/worker
Environment=PYTHONUNBUFFERED=1
Environment=INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=REMPLACER_ICI
Environment=INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=REMPLACER_ICI
ExecStart=/home/brieftube/app/vps/run-worker.sh
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/brieftube/app/worker/worker.log
StandardError=append:/home/brieftube/app/worker/worker.log

[Install]
WantedBy=multi-user.target
